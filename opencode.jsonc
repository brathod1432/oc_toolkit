{
  "$schema": "https://opencode.ai/config.json",

  // ── Global instructions — loaded into EVERY session on this machine ────────
  // Each entry is a file or glob appended to the system prompt.
  // Load order matters: global identity first, then coding standards, then skills.
  // ~ expands to the home directory on both Windows (%USERPROFILE%) and Linux/macOS ($HOME).
  "instructions": [
    // ── Core global context (load in order) ──────────────────────────────────
    "~/.config/opencode/skills/00_global.md",
    "~/.config/opencode/skills/01_coding.md",
    "~/.config/opencode/skills/02_workflow.md",
    "~/.config/opencode/skills/03_lessworks_active.md",
    "~/.config/opencode/skills/04_skills_catalog.md",

    // ── Flat skill files (patterns, templates) ────────────────────────────────
    "~/.config/opencode/skills/fastapi_crud.md",
    "~/.config/opencode/skills/nvidia_api.md",

    // ── Auto-discover every SKILL.md in named skill subdirectories ────────────
    "~/.config/opencode/skills/**/*.md"
  ],

  // ── Providers ──────────────────────────────────────────────────────────────
  // nvidiabuilds and nvidia_models are disabled; nvidia-custom is active.
  // API key is read from the NVIDIA_API_KEY environment variable — never hardcode it here.
  "disabled_providers": ["nvidiabuilds", "nvidia_models"],

  "provider": {
    "nvidiabuilds": {
      "name": "nvidiabuilds",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1"
      },
      "models": {
        "nvidia/llama-3.1-nemotron-70b-instruct": {
          "name": "nvidia/llama-3.1-nemotron-70b-instruct"
        }
      }
    },
    "nvidia_models": {
      "name": "nvidia_models",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1"
      },
      "models": {
        "nvidia/llama-3.1-nemotron-70b-instruct": {
          "name": "nvidia/llama-3.1-nemotron-70b-instruct"
        }
      }
    },
    "nvidia-custom": {
      "name": "nvidia-custom",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1"
      },
      "models": {
        "z-ai/glm-5.3": {
          "name": "z-ai/glm-5.3"
        },
        "nvidia/nemotron-3.5-lightning-30b-a3b": {
          "name": "nvidia/nemotron-3.5-lightning-30b-a3b"
        },
        "meta/muse-glimmer-30b": {
          "name": "meta/muse-glimmer-30b"
        },
        "nvidia/nemotron-3-ultra-550b-a55b": {
          "name": "nvidia/nemotron-3-ultra-550b-a55b"
        },
        "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning": {
          "name": "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning"
        },
        "google/gemma-4-31b-it": {
          "name": "google/gemma-4-31b-it"
        }
      }
    }
  },

  // ── RBG_Runner Orchestrator ────────────────────────────────────────────────
  // Configuration for the intelligent agent orchestrator.
  // The orchestrator agent file is: agents/rgb_runner.md
  // The standalone Python runner is: agents/rgb_runner.py
  //
  // Run once:       python agents/rgb_runner.py
  // Dry-run audit:  python agents/rgb_runner.py --dry-run
  // List agents:    python agents/rgb_runner.py --list
  // Background:     python agents/rgb_runner.py --cycles 10 --interval 60
  //                   (asks for human approval before starting the loop)
  "rgbRunner": {
    // Set to false to disable the orchestrator without removing this config
    "enabled": true,

    // Path to the dependency + scheduling graph for all agents.
    // ~ expands to the home directory on both Windows and Linux/macOS.
    "workflowFile": "~/.config/opencode/agents/workflow.json",

    // Internal memory files — kept in .opencode/ (which must be gitignored).
    // These paths are relative to the project root (no ~ needed).
    "runHistoryFile": ".opencode/memory/run_history.json",
    "logFile":        ".opencode/memory/runner_log.md",

    // Default timezone for cron schedule evaluation (overridable per-agent in workflow.json)
    "timezone": "UTC",

    // Fallback cooldown if an agent in workflow.json doesn't specify one
    "defaultCooldownMinutes": 60,

    // Background execution gate — NEVER bypassed.
    // Loops only start after explicit human approval in the current session.
    // If running unattended (cron / Task Scheduler), always falls back to SINGLE RUN.
    "backgroundGate": {
      "requireApproval": true,
      "fallbackIfUnattended": "SINGLE_RUN"
    },

    // The agent that acts as the top-level orchestrator entry point.
    "entryAgent": "RBG_Runner",
    "entryAgentFile": "~/.config/opencode/agents/rgb_runner.md",

    // Scheduling reference (informational — actual schedules live in workflow.json)
    "_schedulingExamples": {
      "everyMondayAt9am":   "0 9 * * 1",
      "weekdaysAt9am":      "0 9 * * 1-5",
      "every4Hours":        "0 */4 * * *",
      "firstOfEachMonth":   "0 9 1 * *",
      "onDemandOnly":       ""
    }
  }
}
